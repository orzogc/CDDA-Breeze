  { "id": "MZ_移动模式", "type": "widget", "style": "text",
    "default_clause": { "text": "bugging out", "sym": "-", "color": "dark_gray" },
    "clauses": [
      { "id": "run", "text": "跑", "sym": "R", "color": "red", "condition": { "u_has_move_mode": "run" } },
      { "id": "walk", "text": "走", "sym": "W", "color": "white", "condition": { "u_has_move_mode": "walk" } },
      { "id": "crouch", "text": "蹲", "sym": "C", "color": "light_blue", "condition": { "u_has_move_mode": "crouch" } },
      { "id": "prone", "text": "爬", "sym": "P", "color": "green", "condition": { "u_has_move_mode": "prone" } }
