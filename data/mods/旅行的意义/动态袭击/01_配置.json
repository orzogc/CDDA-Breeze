  {
    "type": "effect_on_condition",
    "id": "EOC_TRAVEL_DYNAMIC_REFRESH_WARNING_TIME",
    "//": "每次随行袭击进入预警时调用。把当前世界的分钟设置转换为EOC队列使用的时间长度。已经排队的袭击保存的是排队时的延迟，不会被之后的设置修改追溯改变。",
    "effect": [
      {
        "arithmetic": [
          {
            "global_val": "var",
            "var_name": "travel_dynamic_cfg_warning_minutes"
          },
          "=",
          {
            "world_option": "TRAVEL_CAMP_RAID_WARNING_MINUTES"
          }
        ]
      },
      {
        "arithmetic": [
          {
            "global_val": "var",
            "var_name": "travel_dynamic_cfg_warning_time"
          },
          "=",
          {
            "arithmetic": [
              {
                "global_val": "var",
                "var_name": "travel_dynamic_cfg_warning_minutes"
              },
              "*",
              {
                "time": "1 minute"
              }
            ]
          }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
