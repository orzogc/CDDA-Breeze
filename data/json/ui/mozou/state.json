    "bodypart": "head",
    "default_clause": { "text": "头" },
    "clauses": [
      { "id": "bleedingAndBitten3", "text": "头", "color": "magenta_red", "condition": { "and": [
          { "u_has_effect": "bite" }, { "u_has_effect": "bleed", "intensity": 21 } ] }
      },
      { "id": "bleedingAndBitten12", "text": "头", "color": "magenta", "condition": { "and": [
          { "u_has_effect": "bite" },
          { "u_has_effect": "bleed", "intensity": 1 },
          { "compare_int": [ { "u_val": "effect_intensity", "effect": "bleed" }, "<", { "const": 21 } ] } ] }
      },

      { "id": "bleeding3", "text": "头", "color": "red_red", "condition":
