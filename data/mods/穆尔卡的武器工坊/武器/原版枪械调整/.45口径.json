  {
    "id": "tommygun",
    "copy-from": "tommygun",
    "looks_like": "hk_mp5",
    "type": "GUN",
    "name": {
      "str": "汤普森冲锋枪"
    },
    "description": "汤普森冲锋枪在第一次世界大战末期完成设计，随后因禁酒时期的黑帮、警察与新闻照片而声名大噪。第二次世界大战中，美军、英联邦和多国部队大量使用M1928、M1与M1A1型。它发射.45 ACP弹，近战火力强且操控稳重，但结构昂贵、整枪沉重，最终被更廉价的M3取代。",
    "reload_noise_volume": 10,
    "variant_type": "gun",
    "variants": [
      {
        "id": "tommygun",
        "name": {
          "str": "汤普森 M1928A1 冲锋枪"
        },
        "description": "一把一战末期美国制造的冲锋枪，由于研发太晚，在一战时期没有什么作为。然而，汤普逊冲锋枪在二十世纪20年代在美国黑帮里面很是流行，因此声名狼藉，得名汤米冲锋枪（Tommy Gun）、芝加哥打字机（Chicago Typewriter）、芝加哥小提琴（Chicago Violin）等等。并且该枪在二战时期，在比其更廉价的替代品被研发之前，也被美军装备使用过。",
        "weight": 1
      }
    ],
